{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "AllowedHosts": "*",
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://0.0.0.0:5001"
      }
    }
  },
  "ApiBaseUrl": "http://localhost:5033",
  "Worker": {
    "WorkerId": "worker-1",
    "AllowedTypes": ["email", "sms"],
    "PoolSize": 20,
    "LeaseSeconds": 20,
    "PollIntervalMs": 2000,
    "ShutdownTimeoutSeconds": 60
  },
  "HEALTH_CHECK_DB_TIMEOUT_MS": "2000"
}